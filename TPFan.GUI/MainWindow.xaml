<Window x:Class="TPFan.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TPFan-Win" Height="480" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🌀" FontSize="28" VerticalAlignment="Center"/>
            <TextBlock Text="TPFan-Win" FontSize="24" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Temperature Badge -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                        Background="{Binding TemperatureColorBrush}">
                    <TextBlock Text="{Binding TemperatureDisplay}"
                               FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Stats -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RPM: " FontSize="16" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="{Binding Rpm}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Speed: " FontSize="16" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="{Binding SpeedPercentDisplay}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Mode: " FontSize="16" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="{Binding ModeDisplay}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding ModeColorBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Override Slider -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Manual Override" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ToggleButton Content="Enable" IsChecked="{Binding IsOverrideEnabled, Mode=TwoWay}"
                                  Margin="12,0,0,0" Padding="16,4" Background="{StaticResource AccentBrush}"
                                  Foreground="White" BorderThickness="0" FontWeight="Medium"/>
                </StackPanel>
                <Slider Value="{Binding SelectedSpeedPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                        TickFrequency="20" IsSnapToTickEnabled="True"
                        IsEnabled="{Binding IsOverrideEnabled}"
                        Margin="0,16,0,0" Height="32"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="0%" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                    <TextBlock Text="50%" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="72,0"/>
                    <TextBlock Text="100%" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="72,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Fan Curve Preview -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Fan Curve" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Canvas x:Name="CurveCanvas" Height="120" Background="Transparent"
                        SizeChanged="CurveCanvas_SizeChanged"/>
            </StackPanel>
        </Border>

        <!-- Connection Status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Ellipse Width="10" Height="10" Fill="{Binding ConnectionColorBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" Foreground="{StaticResource SubtleBrush}"/>
        </StackPanel>
    </Grid>
</Window>