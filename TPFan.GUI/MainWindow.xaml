<Window x:Class="TPFan.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TPFan.GUI"
        Title="TPFan-Win"
        Width="900" Height="620"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F9F9F9"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#F9F9F9"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#242424"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#666666"/>
        <SolidColorBrush x:Key="MutedText" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#287FEA"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#32A77C"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#7255D5"/>

        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:MarkerPositionMultiConverter x:Key="MarkerPos"/>

        <!-- === Shared styles === -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        </Style>

        <!-- === Mode RadioButton: base shared properties === -->
        <Style x:Key="ModeRadioButtonBase" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- === Auto: rounded left corners only === -->
        <Style x:Key="ModeRadioButtonLeft" TargetType="RadioButton"
               BasedOn="{StaticResource ModeRadioButtonBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SelectionBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6,0,0,6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBackground"
                                        Property="Background"
                                        Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Manual: rounded right corners only === -->
        <Style x:Key="ModeRadioButtonRight" TargetType="RadioButton"
               BasedOn="{StaticResource ModeRadioButtonBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SelectionBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,6,6,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBackground"
                                        Property="Background"
                                        Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === Icon Geometry Resources === -->
        <Geometry x:Key="ThermometerGeometry">
            M 18 4 L 18 10 L 14 10 L 14 16 L 22 16 L 22 10 L 18 10 Z
            M 14 20 L 14 26 L 18 26 L 18 30 L 14 34 L 10 30 L 10 26 L 14 26 Z
        </Geometry>

        <Geometry x:Key="GaugeGeometry">
            M 24 6 A 18 18 0 1 1 6 24
            M 24 12 L 24 22
            M 24 18 L 30 20
        </Geometry>

        <Geometry x:Key="FanGeometry">
            M 24 8 L 24 18 M 24 8 L 16 20 M 24 8 L 32 20
        </Geometry>
    </Window.Resources>

    <!--
    ============================================================
    ROOT GRID — exactly 3 rows, no spacer
    Row 0 = Stats (with bottom border divider)
    Row 1 = Controls
    Row 2 = Footer
    ============================================================
    -->
    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="260"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ====== ROW 0 : Statistics (with 1 px bottom divider) ====== -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="40,24,40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Temperature -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center">
                        <Viewbox Width="40" Height="40" Margin="0,0,0,18" HorizontalAlignment="Center">
                            <Path Data="{StaticResource ThermometerGeometry}"
                                  Fill="{StaticResource AccentBlue}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Temperature" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TemperatureCelsius}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="°C" Margin="0,5,0,0" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Border>

                <!-- RPM -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center">
                        <Viewbox Width="40" Height="40" Margin="0,0,0,18" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GaugeGeometry}"
                                  Fill="{StaticResource AccentGreen}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="RPM" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Rpm}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text=" RPM" Margin="0,5,0,0" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Border>

                <!-- Speed -->
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center">
                        <Viewbox Width="40" Height="40" Margin="0,0,0,18" HorizontalAlignment="Center">
                            <Path Data="{StaticResource FanGeometry}"
                                  Fill="{StaticResource AccentPurple}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Speed" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SpeedPercent}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text=" %" Margin="0,5,0,0" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ====== ROW 1 : Controls ====== -->
        <Grid Grid.Row="1" Margin="40,24,40,24">
            <StackPanel>
                <TextBlock Text="Mode" FontSize="16" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6"/>

                <!-- Auto / Manual selector — outer Border, no inner padding -->
                <Border Width="370" Height="44"
                        HorizontalAlignment="Left"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0"
                                     Content="Auto"
                                     GroupName="FanMode"
                                     Style="{StaticResource ModeRadioButtonLeft}"
                                     IsChecked="{Binding IsManual, Converter={StaticResource InverseBool}}"/>

                        <RadioButton Grid.Column="1"
                                     Content="Manual"
                                     GroupName="FanMode"
                                     Style="{StaticResource ModeRadioButtonRight}"
                                     IsChecked="{Binding IsManual, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Speed (%)" FontSize="16" Foreground="{StaticResource PrimaryText}" Margin="0,26,0,10"/>

                <!--
                ============================================================
                SLIDER — markers behind, slider/thumb above
                Panel.ZIndex: ItemsControl=0 (below), Slider=10 (on top)
                ============================================================
                -->
                <Grid Height="32" Name="SliderContainer">

                    <!-- MARKERS: rendered BEHIND the slider -->
                    <ItemsControl
                        ItemsSource="{Binding FanCurveSnapPoints}"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Panel.ZIndex="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle
                                    Width="1"
                                    Height="7"
                                    Fill="#8A8A8A"
                                    Opacity="0.75"
                                    VerticalAlignment="Center">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform>
                                            <TranslateTransform.X>
                                                <MultiBinding Converter="{StaticResource MarkerPos}">
                                                    <Binding/>
                                                    <Binding ElementName="SliderContainer"
                                                             Path="ActualWidth"/>
                                                </MultiBinding>
                                            </TranslateTransform.X>
                                        </TranslateTransform>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- SLIDER: rendered ON TOP of markers, thumb always visible -->
                    <Slider
                        x:Name="SpeedSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding SelectedSpeedPercent,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsManual}"
                        TickPlacement="None"
                        Panel.ZIndex="10"/>

                </Grid>

                <!-- 0% / 100% labels -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="0%" HorizontalAlignment="Left" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ====== ROW 2 : Footer ====== -->
        <Border Grid.Row="2"
                Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <TextBlock Text="v0.4.0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource MutedText}"/>
                <Button Content="Minimize to tray"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="{StaticResource SecondaryText}"
                        Padding="8,5"
                        Command="{Binding MinimizeToTrayCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
