<Window x:Class="TPFan.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TPFan-Win" Height="480" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🌀" FontSize="28" VerticalAlignment="Center"/>
            <TextBlock Text="TPFan-Win" FontSize="24" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Temperature Badge -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                        Background="{Binding TemperatureColorBrush}">
                    <TextBlock Text="{Binding TemperatureDisplay}"
                               FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Stats -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RPM: " FontSize="16" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="{Binding Rpm}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Speed: " FontSize="16" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="{Binding SpeedPercentDisplay}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Mode: " FontSize="16" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="{Binding ModeDisplay}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding ModeColorBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Override Slider -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <!-- Mode Toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fan Control" FontSize="16" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Current: " FontSize="13" Foreground="{StaticResource SubtleBrush}"/>
                            <TextBlock Text="{Binding ModeDisplay}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding ModeColorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsOverrideEnabled, Mode=TwoWay}"
                                  Width="60" Height="30"
                                  VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid>
                                    <Border x:Name="bg" Background="#333" CornerRadius="15" Width="60" Height="30"/>
                                    <Ellipse x:Name="dot" Width="22" Height="22" Fill="White"
                                             HorizontalAlignment="Left" Margin="4,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="dotTransform"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="label" Text="A" Foreground="White" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#0078D4"/>
                                        <Setter TargetName="label" Property="Text" Value="M"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="dotTransform"
                                                        Storyboard.TargetProperty="X" To="28" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="dotTransform"
                                                        Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <!-- Speed Slider (shown only when override is active) -->
                <StackPanel Visibility="{Binding IsOverrideEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,16,0,0">
                    <TextBlock Text="{Binding SelectedSpeedPercent, StringFormat={}{0}%}"
                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"/>
                    <Slider Value="{Binding SelectedSpeedPercent, Mode=TwoWay}"
                            Minimum="0" Maximum="100" Margin="0,8,0,0" Height="32"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="0%" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="50%" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="72,0"/>
                        <TextBlock Text="100%" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="72,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Connection Status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Ellipse Width="10" Height="10" Fill="{Binding ConnectionColorBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" Foreground="{StaticResource SubtleBrush}"/>
        </StackPanel>
    </Grid>
</Window>