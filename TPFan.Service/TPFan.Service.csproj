<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>TPFan.Service</RootNamespace>
    <AssemblyName>TPFan.Service</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsDesktopSdk>true</UseWindowsDesktopSdk>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TPFan.Shared\TPFan.Shared.csproj" />
  </ItemGroup>

  <!-- Expose internal helpers (e.g. EcFanController.MapPercentToLevel) to
       the unit test project without leaking them to consumers. The test
       project also uses public statics (LibreHardwareMonitorSensorService
       .IsFanPercentValid, etc.) so this only widens access for tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TPFan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.5" />
    <PackageReference Include="System.Management" Version="10.0.1" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- Native dependency for EC fan control (InpOut32).
       The 64-bit build expects inpoutx64.dll beside the executable.
       Obtain the pair inpoutx64.dll + inpoutx64.sys from
       https://www.highrez.co.uk/Downloads/InpOut32/ / InstallDriver.exe,
       or build from the InpOut32 source. The files are intentionally not
       vendored — see SETUP.md for the install step. If native/inpoutx64.dll
       is present in the repo, it is copied to the output directory. -->
  <ItemGroup>
    <None Include="native\**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\inpoutx64.dll')" />
  </ItemGroup>

</Project>
