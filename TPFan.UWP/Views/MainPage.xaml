<Page
    x:Class="TPFan.UWP.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:TPFan.Shared.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="ThinkPad T480 Fan Control"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Monitor dan kontrol kecepatan fan"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <!-- Current Status -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Temperature -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="Temperature"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentStatus.TemperatureCelsius, Mode=OneWay}"
                           Style="{StaticResource HeaderTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="°C"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Fan Speed -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Fan Speed"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentStatus.SpeedPercent, Mode=OneWay}"
                           Style="{StaticResource HeaderTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="%"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- RPM -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="RPM"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentStatus.Rpm, Mode=OneWay}"
                           Style="{StaticResource HeaderTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="RPM"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Override Section -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="12">
            <ToggleSwitch Header="Manual Override"
                          IsOn="{x:Bind ViewModel.IsOverrideEnabled, Mode=TwoWay}"
                          OffContent="Auto"
                          OnContent="Manual"/>

            <!-- Speed Slider with Snapping -->
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="Fan Speed" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedSpeedPercent, Mode=OneWay}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Slider Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.SelectedSpeedPercent, Mode=TwoWay}"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        IsEnabled="{x:Bind ViewModel.IsOverrideEnabled, Mode=OneWay}"/>

                <!-- Snap Points Display -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.SnapPoints, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Button Content="{x:Bind}"
                                    Margin="2,0"
                                    Padding="8,4"
                                    FontSize="12"
                                    Click="SnapPointButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Fan Curve Data Display -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Fan Curve Data"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <ListView ItemsSource="{x:Bind ViewModel.CurrentCurve.Points, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:FanCurvePoint">
                        <Grid Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind TemperatureCelsius}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="°C →"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind SpeedPercent}"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing IsActive="True"
                          Width="48"
                          Height="48"/>
        </Grid>
    </Grid>
</Page>
